# Variables d'environnement.
# En local, « npm run dev » crée .env.local tout seul : rien à faire.
# En ligne, à déclarer dans le projet Vercel (voir DEPLOIEMENT.md).

# Injectées automatiquement par les intégrations Vercel :
DATABASE_URL=postgres://...            # Neon (Marketplace Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_...  # Vercel Blob

# À créer (32 caractères aléatoires ou plus, différents les uns des autres) :
SESSION_SECRET=
IP_SECRET=
CRON_SECRET=

# Adresse publique du site (sert au contrôle d'origine des requêtes)
PUBLIC_ORIGIN=https://transactions.petragest.com

# Garder le corps brut des requêtes lisible (envoi des photos)
NODEJS_HELPERS=0
